# Desenvolvimento local (pnpm dev:api, pnpm migrar, pnpm semear)
DATABASE_URL=postgres://central:central_local@localhost:5443/central
PORT=3200

# Banco descartável para os testes de integração da API (o teste apaga o schema central)
TEST_DATABASE_URL=postgres://central:central_local@localhost:5443/central_teste

# docker compose (copie estas para infra/.env se quiser mudar)
CENTRAL_DB_NOME=central
CENTRAL_DB_USUARIO=central
CENTRAL_DB_SENHA=central_local
CENTRAL_DB_PORTA=5443
CENTRAL_API_PORTA=3200
CENTRAL_WEB_PORTA=8280

# Login (obrigatório, inclusive no docker compose: copie para infra/.env)
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_VALIDADE=8h

# Origens autorizadas a chamar a API de fora (APK: http://localhost), separadas por vírgula
CORS_ORIGENS=
